# Copia este archivo a .env y ajusta los valores.

# Contraseña de PostgreSQL. Usa solo letras y números (sin ; = o espacios).
POSTGRES_PASSWORD=cambia-esta-contrasena

# IP del servidor en la red de la oficina (por ejemplo 192.168.1.10).
API_IP=192.168.1.10

# Clave para firmar las sesiones. Mínimo 32 caracteres. Genérala con: openssl rand -hex 32
JWT_KEY=cambia-esta-clave-por-una-generada

# Primer administrador. Solo se crea cuando no hay usuarios en el sistema.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NOMBRE=Administrador

# Zona horaria del servidor para el respaldo semanal (sábados 18:00). Ejemplo: America/Mexico_City
ZONA_HORARIA=America/Mexico_City
